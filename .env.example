# Example environment variables. Copy to `.env` and fill in real values.
# NEVER commit a real `.env` (it is gitignored). Keep secrets out of code,
# logs, and agent output.

# ── Runtime mode ─────────────────────────────────────────────────────
# local (default): approvals/kill do not require a shared token.
# shared: require DASHBOARD_API_TOKEN for approval and kill mutations.
# CORPOS_MODE=local
# DASHBOARD_API_TOKEN=

# ── Data ─────────────────────────────────────────────────────────────
# Local libsql / SQLite file used by the firm store (default: data/company.db).
# CORPOS_DB=data/company.db

# ── HTTP ─────────────────────────────────────────────────────────────
# PORT=3000

# ── Model providers ──────────────────────────────────────────────────
# Default is SimulationProvider (health.mode=simulation).
# Live HttpLLMProvider only when BOTH are set:
#   CORPOS_ALLOW_LIVE=1
#   OPENROUTER_API_KEY=...
# OPENROUTER_API_KEY alone does NOT switch agents to live reasoning.
# CORPOS_ALLOW_LIVE=0
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
